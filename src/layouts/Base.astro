---
import '../styles/global.css';
import IndexRail from '../components/IndexRail.astro';

const { title, description, showRail = true } = Astro.props;
const siteName = '推論 SUIRON';
const pageTitle = title ? `${title} | ${siteName}` : siteName;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={pageTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Noto+Sans+JP:wght@400;500;700&family=Noto+Serif+JP:wght@700;900&display=swap"
    />
  </head>
  <body>
    <header class="masthead">
      <div class="wrap">
        <a class="logo" href="/">
          <span class="kanji">推論</span>
          <span class="roman">Suiron</span>
        </a>
        <span class="tagline">AIの現在地を、数字と一次情報で。</span>
      </div>
    </header>

    <nav class="nav">
      <div class="wrap">
        <a href="/">記事</a>
        <a href="/indicators/">インデックス</a>
        <a href="/method/">算出方法・編集方針</a>
      </div>
    </nav>

    {showRail && <IndexRail />}

    <slot />

    <footer>
      <div class="wrap">
        <a href="/method/">編集方針</a>
        <a href="/method/#corrections">訂正ポリシー</a>
        <a href="/indicators/">指標の生データ</a>
        <span class="r">© {year} 推論 / SUIRON</span>
        <p class="ack">
          論文数の集計には arXiv の公開APIを使用しています。
          Thank you to arXiv for use of its open access interoperability.<br />
          推論コストは OpenRouter の公開モデル一覧から算出しています。算出方法と生データは
          <a href="/method/">こちら</a>。
        </p>
      </div>
    </footer>
  </body>
</html>
